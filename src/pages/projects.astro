---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
import { caseStudies } from "../data/caseStudies";

// Sort: featured first, then category, then title
const sortedProjects = [...projects].sort((a, b) => {
  const af = a.featured ? 0 : 1;
  const bf = b.featured ? 0 : 1;
  if (af !== bf) return af - bf;

  const cat = a.category.localeCompare(b.category);
  if (cat !== 0) return cat;

  return a.title.localeCompare(b.title);
});
const featuredProjects = sortedProjects.filter((p) => p.featured);
const gridProjects = sortedProjects.filter((p) => !p.featured);
const allForPreview = sortedProjects; // includes featured + non-featured
const previewData = Object.fromEntries(
  allForPreview.map((p) => [
    p.slug,
    {
      slug: p.slug,
      title: p.title,
      category: p.category,
      dataset: p.dataset,
      oneLiner: p.oneLiner,
      coverImage: p.coverImage,
      repoUrl: p.repoUrl,
      screenshots: (caseStudies[p.slug]?.screenshots ?? []).map((s) => s.src),
    },
  ])
);
const categories = ["All", ...Array.from(new Set(sortedProjects.map((p) => p.category)))];
---



<Layout
  title="Projects | Mohammad Abu Huzaifa"
  description="Selected data analytics projects: dashboards, EDA, predictive insights, and reporting."
>
  <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
  <p class="mt-2 text-slate-300 max-w-2xl">
    Curated projects with clear problem framing, approach, and measurable outcomes.
  </p>

  {featuredProjects.length ? (
    <section class="mt-10">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-xl font-semibold">Featured</h2>
        <p class="text-sm text-slate-400">High-impact case studies</p>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((p) => (
          <article class="group rounded-2xl p-2 transition hover:bg-white/5">
            <a href={`/projects/${p.slug}`} class="block">
              <div class="aspect-[16/9] overflow-hidden rounded-2xl border border-white/10 bg-black/30">
                <img
                  src={p.coverImage}
                  alt={`${p.title} cover`}
                  class="h-full w-full object-cover opacity-90"
                  loading="lazy"
                  onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                />
              </div>

              <div class="p-4">
                <div class="flex items-center justify-between gap-3">
                  {p.proof?.length ? (
                    <div class="mt-3 flex flex-wrap gap-2">
                      {p.proof.slice(0, 3).map((tag) => (
                        <span class="text-[11px] rounded-full border border-white/10 bg-white/5 px-2 py-1 text-slate-300">
                          {tag}
                        </span>
                      ))}
                    </div>
                  ) : null}
                  <div class="text-xs text-slate-300">{p.category} • {p.dataset}</div>
                  <span class="text-[11px] rounded-full border border-sky-400/30 bg-sky-400/10 px-2 py-1 text-sky-200">
                    Featured
                  </span>
                </div>

                <div class="mt-2 font-semibold group-hover:underline underline-offset-4">{p.title}</div>
                <div class="mt-2 text-sm text-slate-300">{p.oneLiner}</div>
              </div>
            </a>

            <div class="px-5 pb-5 flex gap-3">
              <a class="text-sm text-sky-300 hover:underline" href={`/projects/${p.slug}`}>Case study →</a>
              <a class="text-sm text-slate-300 hover:text-white" href={p.repoUrl} target="_blank" rel="noopener noreferrer">GitHub →</a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-6 border-t border-white/10"></div>
    </section>
  ) : null}


  <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex-1">
      <label for="project-search" class="sr-only">Search projects</label>

      <div class="flex gap-2">
        <input
          id="project-search"
          type="search"
          placeholder="Search by title, tech stack, or keywords…"
          class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-100 placeholder:text-slate-400 outline-none focus:border-white/20"
        />

        <button
          id="clear-search"
          type="button"
          class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-slate-200 hover:bg-white/10 transition"
        >
          Clear
        </button>
      </div>

      <p class="mt-2 text-xs text-slate-400">
        Tip: try “Power BI”, “FastAPI”, “R”, “forecast”, “anomaly”, “MySQL”
      </p>
    </div>

    <div class="text-sm text-slate-300 pt-1">
      <span class="text-slate-400">Grid:</span>
      <span id="project-count">0</span>
      <span class="text-slate-500 ml-2">(Featured shown above: {featuredProjects.length})</span>
    </div>
  </div>


  <div class="mt-10 flex flex-wrap gap-3" id="project-filters">
    {categories.map((c) => (
      <button
        type="button"
        data-filter={c}
        class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 hover:bg-white/10 transition"
      >
        {c}
      </button>
    ))}
  </div>

  <div class="mt-8 border-t border-white/30"></div>

  <div id="projects-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {gridProjects.map((p) => (
      <article
        class="group rounded-2xl p-2 transition hover:bg-white/5 flex flex-col h-full"
        data-category={p.category}
        data-search={`${p.title} ${p.oneLiner} ${p.stack.join(" ")}`.toLowerCase()}
      >

        <a href={`/projects/${p.slug}`} class="block flex-1">
          <div class="aspect-[16/9] overflow-hidden rounded-2xl border border-white/10 bg-black/30">
            <img
              src={p.coverImage}
              alt={`${p.title} cover`}
              class="h-full w-full object-cover opacity-90"
              loading="lazy"
              onerror="this.onerror=null;this.src='/images/placeholder.svg';"
            />
          </div>

          <div class="p-4">
            <div class="flex items-center justify-between gap-3">
              <div class="text-xs text-slate-400">{p.category} • {p.dataset}</div>
              {p.proof?.length ? (
                <div class="mt-3 flex flex-wrap gap-2">
                  {p.proof.slice(0, 3).map((tag) => (
                    <span class="text-[11px] rounded-full border border-white/10 bg-white/5 px-2 py-1 text-slate-300">
                      {tag}
                    </span>
                  ))}
                </div>
              ) : null}

              {p.featured ? (
              <span class="text-[11px] rounded-full border border-sky-400/30 bg-sky-400/10 px-2 py-1 text-sky-200">
              Featured
              </span>
              ) : null}
            </div>
            <div class="mt-2 font-semibold group-hover:underline underline-offset-4">{p.title}</div>
            <div class="mt-2 text-sm text-slate-300">{p.oneLiner}</div>
          </div>
        </a>

        <div class="mt-3 flex flex-wrap gap-3 px-2 pb-2">
          <a class="text-sm text-sky-400 hover:underline" href={`/projects/${p.slug}`}>
            Case study →
          </a>

          <button
            type="button"
            class="text-sm text-slate-300 hover:text-white"
            data-preview-slug={p.slug}
          >
            Preview →
          </button>

          {p.demoUrl ? (
            <a class="text-sm text-slate-300 hover:text-white" href={p.demoUrl} target="_blank" rel="noopener noreferrer">
              Live demo →
            </a>
          ) : null}

          <a class="text-sm text-slate-300 hover:text-white" href={p.repoUrl} target="_blank" rel="noopener noreferrer">
            GitHub →
          </a>
        </div>

      </article>
    ))}
  </div>

  <div
    id="no-results"
    class="mt-6 hidden rounded-xl border border-white/10 bg-white/5 p-6 text-slate-300"
  >
    <p class="font-medium text-slate-100">No matching projects found.</p>
    <p class="mt-2 text-sm text-slate-400">
      Try a different keyword (e.g., <span class="text-slate-300">Power BI</span>, <span class="text-slate-300">Python</span>, <span class="text-slate-300">R</span>) or click a different category filter.
    </p>
  </div>

  <dialog
    id="projects-quickview"
    class="backdrop:bg-black/70 rounded-2xl border border-white/10 bg-slate-950 text-slate-100 w-[min(900px,92vw)]"
  >
    <div class="p-5 sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div id="pqv-meta" class="text-xs text-slate-400"></div>
          <h3 id="pqv-title" class="mt-2 text-2xl font-semibold"></h3>
          <p id="pqv-desc" class="mt-2 text-slate-300"></p>
        </div>

        <button
          id="pqv-close"
          type="button"
          class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-200 hover:bg-white/5"
        >
          Close
        </button>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <img
          id="pqv-img-1"
          class="aspect-[16/9] w-full rounded-xl border border-white/10 object-cover bg-black/30"
          alt="Preview screenshot 1"
          onerror="this.onerror=null;this.src='/images/placeholder.svg';"
        />
        <img
          id="pqv-img-2"
          class="aspect-[16/9] w-full rounded-xl border border-white/10 object-cover bg-black/30"
          alt="Preview screenshot 2"
          onerror="this.onerror=null;this.src='/images/placeholder.svg';"
        />
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          id="pqv-case"
          class="rounded-lg bg-sky-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:opacity-90"
          href="#"
        >
          Open case study
        </a>

        <a
          id="pqv-github"
          class="rounded-lg border border-white/10 px-4 py-2 text-sm text-slate-100 hover:bg-white/5"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </dialog>

  <script is:inline>
    /** @type {HTMLElement|null} */
    const filtersEl = document.getElementById("project-filters");

    /** @type {HTMLButtonElement[]} */
    const buttons = filtersEl ? Array.from(filtersEl.querySelectorAll('button[data-filter]')) : [];

    /** @type {HTMLElement[]} */
    const cards = Array.from(document.querySelectorAll("#projects-grid article[data-category]"));

    /** @type {HTMLInputElement|null} */
    const searchInput = document.getElementById("project-search");

    /** @type {HTMLButtonElement|null} */
    const clearBtn = document.getElementById("clear-search");

    /** @type {HTMLElement|null} */
    const countEl = document.getElementById("project-count");

    /** @type {HTMLElement|null} */
    const noResultsEl = document.getElementById("no-results");

    /** @param {string} value */
    function setActiveButton(value) {
      for (const btn of buttons) {
        const isActive = btn.dataset.filter === value;
        btn.classList.toggle("bg-white/10", isActive);
        btn.classList.toggle("border-white/20", isActive);
        btn.classList.toggle("text-white", isActive);
      }
    }

    /** @returns {{cat: string, q: string}} */
    function getState() {
      const url = new URL(window.location.href);
      const cat = url.searchParams.get("cat") || "All";
      const q = url.searchParams.get("q") || "";
      return { cat, q };
    }

    /** @param {{cat: string, q: string}} state */
    function setState({ cat, q }) {
      const url = new URL(window.location.href);

      if (!cat || cat === "All") url.searchParams.delete("cat");
      else url.searchParams.set("cat", cat);

      if (!q || !q.trim()) url.searchParams.delete("q");
      else url.searchParams.set("q", q.trim());

      window.history.replaceState({}, "", url);
    }

    /** @param {{cat: string, q: string}} state */
    function applyFilters({ cat, q }) {
      const selectedCat = cat || "All";
      const query = (q || "").trim().toLowerCase();

      let shown = 0;

      for (const card of cards) {
        const cardCat = card.getAttribute("data-category") || "";
        const hay = (card.getAttribute("data-search") || "").toLowerCase();

        const matchCat = selectedCat === "All" || cardCat === selectedCat;
        const matchQ = !query || hay.includes(query);

        const show = matchCat && matchQ;
        card.style.display = show ? "" : "none";
        if (show) shown += 1;
      }

      setActiveButton(selectedCat);

      if (countEl) countEl.textContent = `${shown} / ${cards.length}`;
      if (noResultsEl) noResultsEl.classList.toggle("hidden", shown !== 0);
    }

    // Init from URL
    const initial = getState();
    if (searchInput) searchInput.value = initial.q;
    applyFilters(initial);

    // Category clicks
    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        const next = { ...getState(), cat: btn.dataset.filter || "All" };
        setState(next);
        applyFilters(next);
      });
    }

    /** @type {ReturnType<typeof setTimeout> | undefined} */
    let t;

    // Search typing (debounced)
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        if (t) clearTimeout(t);
        t = setTimeout(() => {
          const next = { ...getState(), q: searchInput.value || "" };
          setState(next);
          applyFilters(next);
        }, 120);
      });
    }

    // Clear search
    if (clearBtn && searchInput) {
      clearBtn.addEventListener("click", () => {
        searchInput.value = "";
        const next = { ...getState(), q: "" };
        setState(next);
        applyFilters(next);
        searchInput.focus();
      });
    }
  </script>

  <script is:inline define:vars={{ previewData }}>
    const data = previewData;

    /** @type {HTMLDialogElement|null} */
    const dlg = document.getElementById("projects-quickview");
    /** @type {HTMLButtonElement|null} */
    const closeBtn = document.getElementById("pqv-close");

    /** @type {HTMLElement|null} */
    const metaEl = document.getElementById("pqv-meta");
    /** @type {HTMLElement|null} */
    const titleEl = document.getElementById("pqv-title");
    /** @type {HTMLElement|null} */
    const descEl = document.getElementById("pqv-desc");

    /** @type {HTMLImageElement|null} */
    const img1 = document.getElementById("pqv-img-1");
    /** @type {HTMLImageElement|null} */
    const img2 = document.getElementById("pqv-img-2");

    /** @type {HTMLAnchorElement|null} */
    const caseLink = document.getElementById("pqv-case");
    /** @type {HTMLAnchorElement|null} */
    const githubLink = document.getElementById("pqv-github");

    /** @param {string} slug */
    function openPreview(slug) {
      const p = data[slug];
      if (!p || !dlg) return;

      if (metaEl) metaEl.textContent = `${p.category} • ${p.dataset}`;
      if (titleEl) titleEl.textContent = p.title;
      if (descEl) descEl.textContent = p.oneLiner;

      const shots = (p.screenshots && p.screenshots.length ? p.screenshots : [p.coverImage]).slice(0, 2);
      if (img1) img1.src = shots[0] || "/images/placeholder.svg";
      if (img2) img2.src = shots[1] || shots[0] || "/images/placeholder.svg";

      if (caseLink) caseLink.href = `/projects/${p.slug}`;
      if (githubLink) githubLink.href = p.repoUrl || "#";

      dlg.showModal();
    }

    document.querySelectorAll("[data-preview-slug]").forEach((btn) => {
      btn.addEventListener("click", () => openPreview(btn.getAttribute("data-preview-slug") || ""));
    });

    closeBtn?.addEventListener("click", () => dlg?.close());

    dlg?.addEventListener("click", (e) => {
      const rect = dlg.getBoundingClientRect();
      const inDialog =
        rect.top <= e.clientY && e.clientY <= rect.bottom && rect.left <= e.clientX && e.clientX <= rect.right;
      if (!inDialog) dlg.close();
    });

    document.addEventListener("keydown", (e) => {
      if (!dlg || !dlg.open) return;
      if (e.key === "Escape") dlg.close();
    });
  </script>
</Layout>