---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";

const timeline = [
  {
    year: "2022",
    title: "Started Computer Science",
    desc: "Began my degree at Asia Pacific University of Technology & Innovation (APU), Malaysia — building foundations in programming, algorithms, and systems thinking.",
    tag: "Education",
  },
  {
    year: "2023",
    title: "Pivoted into Data Analytics",
    desc: "Discovered a strong pull toward working with data — started exploring Python, EDA, and Power BI. Moved coursework focus toward analytics and machine learning.",
    tag: "Transition",
  },
  {
    year: "2024",
    title: "Built Real-World Projects",
    desc: "Developed end-to-end case studies: fraud detection models, BI dashboards for global sales data, and predictive maintenance systems deployed with FastAPI + Streamlit.",
    tag: "Projects",
  },
  {
    year: "2025",
    title: "Focused on Decision Systems",
    desc: "Deepened work on explainable AI, threshold-optimized predictions, and stakeholder-ready reporting — building analytics that support real operational decisions.",
    tag: "Growth",
  },
];

const values = [
  {
    icon: `<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>`,
    title: "Clarity over complexity",
    desc: "Great analysis is useless if it can't be understood. I always optimize for the decision-maker, not the data scientist.",
  },
  {
    icon: `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>`,
    title: "Real-world relevance",
    desc: "Every project I take on starts with a business question. The technical work follows the problem, not the other way around.",
  },
  {
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
    title: "Honest evaluation",
    desc: "I care about metrics that matter — threshold trade-offs, false positive costs, and decision boundaries — not just raw accuracy.",
  },
];
---

<Layout
  title={`About | ${profile.name}`}
  description={`About ${profile.name} — Data Analyst focused on BI dashboards, predictive insights, and decision support.`}
>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="grid gap-10 lg:grid-cols-2 lg:items-center" data-reveal>

    <!-- Image -->
    <div class="flex justify-center lg:order-last lg:justify-end">
      <div class="relative">
        <div class="absolute -inset-3 rounded-[32px] bg-gradient-to-br from-sky-400/20 via-transparent to-indigo-400/15 blur-xl"></div>
        <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-black/20 p-2">
          <img
            src="/images/headshot.png"
            alt={`${profile.name} — Data Analyst`}
            class="h-[380px] w-[300px] object-cover rounded-[22px]"
            loading="eager"
            onerror="this.onerror=null;this.src='/images/placeholder.svg';"
          />
        </div>
      </div>
    </div>

    <!-- Text -->
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-sky-400/70">About me</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl leading-[1.1]">
        Hello, I'm<br />
        <span class="text-sky-400">{profile.name.split(" ").slice(-1)[0]}.</span>
      </h1>

      <p class="mt-5 text-slate-300 leading-relaxed max-w-lg">
        I'm a Data Analyst with a Computer Science background, specializing in BI dashboards,
        predictive analytics, and decision support. I enjoy transforming complex datasets into
        clear, actionable insights that help organizations make better decisions.
      </p>

      <p class="mt-4 text-slate-300 leading-relaxed max-w-lg">
        My work combines business understanding with technical execution — building dashboards,
        exploring trends, and developing predictive models that deliver real-world value.
      </p>

      <!-- Status + location -->
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/25 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300 font-medium">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Open to roles
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-400">
          {profile.location}
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-400">
          {profile.roleLine}
        </span>
      </div>

      <!-- Social links -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={profile.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 hover:border-sky-400/30 hover:text-sky-300 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect width="4" height="12" x="2" y="9"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          LinkedIn
        </a>
        <a
          href={profile.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 hover:border-sky-400/30 hover:text-sky-300 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200 hover:border-sky-400/30 hover:text-sky-300 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          Email
        </a>
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-sky-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:opacity-90 transition-opacity"
        >
          Download CV
        </a>
      </div>
    </div>
  </section>


  <div class="mt-16 border-t border-white/10"></div>


  <!-- ══════════════════════════════════════════════
       MY STORY
  ══════════════════════════════════════════════ -->
  <section class="mt-16" data-reveal>
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:items-start">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.25em] text-sky-400/70">Background</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight">My Story</h2>
        <p class="mt-3 text-sm text-slate-500 leading-relaxed">
          How I went from Computer Science to building real analytics systems.
        </p>
      </div>

      <div class="space-y-5 text-slate-300 leading-relaxed">
        <p>
          I began my journey in Computer Science and gradually transitioned into Data Analytics,
          drawn in by the fast-growing, high-impact nature of the field. I discovered a strong
          passion for working with data — not just processing it, but extracting the kind of
          insight that actually changes decisions.
        </p>
        <p>
          I studied at <span class="text-slate-100 font-medium">Asia Pacific University of Technology & Innovation (APU), Malaysia</span>,
          where I developed strong foundations in analytics, machine learning, and data-driven
          problem solving. APU gave me both the technical rigor and the exposure to real datasets
          that shaped how I approach analytical work today.
        </p>
        <p>
          I enjoy working across the full analytics spectrum — from BI dashboards and exploratory
          analysis to predictive modeling and deployed decision-support apps. What I find most
          rewarding is when a well-structured dashboard or a clear model output actually changes
          how a team makes a call.
        </p>
        <p>
          My goal is to build a career where data work creates measurable, sustainable impact —
          not just reports that sit unread, but insights that drive action.
        </p>
      </div>
    </div>
  </section>


  <div class="mt-16 border-t border-white/10"></div>


  <!-- ══════════════════════════════════════════════
       VALUES
  ══════════════════════════════════════════════ -->
  <section class="mt-16" data-reveal>
    <div class="text-center max-w-xl mx-auto">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-sky-400/70">How I work</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight">What I care about</h2>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {values.map(({ icon, title, desc }) => (
        <article class="group rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-300 hover:border-sky-400/20 hover:bg-white/[0.06] hover:-translate-y-1">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-sky-300 transition duration-300 group-hover:border-sky-400/30 group-hover:scale-110">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
          </div>
          <h3 class="mt-4 font-semibold text-slate-100">{title}</h3>
          <p class="mt-2 text-sm text-slate-400 leading-relaxed">{desc}</p>
        </article>
      ))}
    </div>
  </section>


  <div class="mt-16 border-t border-white/10"></div>


  <!-- ══════════════════════════════════════════════
       TIMELINE
  ══════════════════════════════════════════════ -->
  <section class="mt-16" data-reveal>
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:items-start">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.25em] text-sky-400/70">History</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight">My Journey</h2>
        <p class="mt-3 text-sm text-slate-500 leading-relaxed">
          A timeline of the key moments that shaped my path into data analytics.
        </p>
      </div>

      <!-- Timeline items -->
      <div class="relative">
        <!-- Vertical rule -->
        <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/10"></div>

        <div class="space-y-10 pl-8">
          {timeline.map(({ year, title, desc, tag }, i) => (
            <div class="group relative">
              <!-- Dot -->
              <div class="absolute -left-8 top-1.5 flex h-4 w-4 items-center justify-center">
                <div class="h-2.5 w-2.5 rounded-full bg-sky-400 shadow-[0_0_8px_2px_rgba(56,189,248,0.35)] transition duration-300 group-hover:scale-125"></div>
              </div>

              <!-- Card -->
              <div class="rounded-xl border border-white/10 bg-white/[0.03] p-5 transition duration-200 group-hover:border-white/20 group-hover:bg-white/[0.06]">
                <div class="flex items-center gap-3">
                  <span class="text-xs font-mono text-sky-400">{year}</span>
                  <span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-[10px] text-slate-500">{tag}</span>
                </div>
                <h3 class="mt-2 font-semibold text-slate-100 group-hover:text-sky-300 transition-colors">{title}</h3>
                <p class="mt-1.5 text-sm text-slate-400 leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <div class="mt-16 border-t border-white/10"></div>


  <!-- ══════════════════════════════════════════════
       CTA
  ══════════════════════════════════════════════ -->
  <section class="mt-16" data-reveal>
    <div class="rounded-2xl border border-sky-400/15 bg-sky-400/5 px-8 py-10 sm:px-12 sm:py-12 text-center">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-sky-400/70">Next step</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
        Let's work together.
      </h2>
      <p class="mt-3 text-slate-400 max-w-lg mx-auto text-sm leading-relaxed">
        I'm open to Data Analyst roles, BI projects, and analytics collaboration.
        Check out my work first, or reach out directly.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a
          href="/projects"
          class="rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-sm text-slate-100 hover:bg-white/10 transition-colors"
        >
          View Projects
        </a>
        <a
          href="/contact"
          class="rounded-lg bg-sky-400 px-5 py-2.5 text-sm font-semibold text-slate-950 hover:opacity-90 transition-opacity"
        >
          Contact Me →
        </a>
      </div>
    </div>
  </section>

</Layout>