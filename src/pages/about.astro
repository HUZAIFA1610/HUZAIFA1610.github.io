---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About | Mohammad Abu Huzaifa"
  description="About Mohammad Abu Huzaifa — Data Analyst focused on BI dashboards, predictive insights, and decision support."
>

  <!-- SECTION 1: HERO (Image + Intro) -->
  <section class="mt-16 grid gap-10 lg:grid-cols-2 items-center" data-reveal>

    <!-- LEFT: IMAGE -->
    <div class="relative">
      <div class="absolute inset-0 rounded-2xl bg-sky-400/10 blur-2xl"></div>
      <img
        src="/images/headshot.png"
        alt="Mohammad Abu Huzaifa"
        class="rounded-xl transition duration-500 group-hover:scale-105 group-hover:shadow-2xl"
      />
      <div class="absolute inset-0 rounded-xl bg-sky-400/10 opacity-0 group-hover:opacity-100 transition"></div>
    </div>

    <!-- RIGHT: TEXT -->
    <div>
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight">Hello</h1>

      <p class="mt-4 text-slate-300 leading-relaxed max-w-xl">
        I’m a Data Analyst with a background in Computer Science, specializing in BI dashboards,
        predictive analytics, and decision support. I enjoy transforming complex datasets into
        clear insights that help organizations make better decisions.
      </p>

      <p class="mt-4 text-slate-300 leading-relaxed max-w-xl">
        My work focuses on combining business understanding with technical execution—building
        dashboards, exploring trends, and developing predictive models that deliver real-world value.
      </p>

      <!-- SOCIAL LINKS -->
      <div class="mt-6 flex gap-4">
        <a href="https://www.linkedin.com/in/mohammad-abu-huzaifa-b98314279/" class="p-3 rounded-lg bg-white/5 hover:bg-sky-400/20 transition">
          LinkedIn
        </a>

        <a href="https://github.com/HUZAIFA1610" class="p-3 rounded-lg bg-white/5 hover:bg-sky-400/20 transition">
          GitHub
        </a>

        <a href="mailto:huzaifanafiz6@gmail.com" class="p-3 rounded-lg bg-white/5 hover:bg-sky-400/20 transition">
          Email
        </a>
      </div>
      <div class="h-px bg-white/10 my-16"></div>
    </div>
  </section>

  <!-- DIVIDER -->
  <div class="mt-16 border-t border-white/30"></div>

  <!-- SECTION 2: MY STORY -->
  <section class="mt-16 max-w-3xl mx-auto" data-reveal>
    <h2 class="text-2xl font-semibold text-center">My Story</h2>

    <div class="mt-6 text-slate-300 leading-relaxed space-y-4 text-center">
      <p>
        I began my journey in Computer Science and gradually transitioned into Data Analytics,
        driven by the fast-growing and highly competitive nature of the industry.
        I discovered a strong passion for working with data and extracting meaningful insights.
      </p>

      <p>
        I studied at Asia Pacific University of Technology & Innovation (APU), Malaysia,
        where I developed strong foundations in analytics, machine learning, and data-driven problem solving.
      </p>

      <p>
        I enjoy working across BI dashboards, machine learning, deep learning, and predictive modeling—
        especially when solving real-world business problems through structured analysis and visualization.
      </p>

      <p>
        My goal is to create meaningful impact in the industry while continuously improving
        and contributing to sustainable, data-driven decision making.
      </p>
    </div>
  </section>

  <!-- DIVIDER -->
  <div class="mt-16 border-t border-white/30"></div>

  <!-- SECTION 3: MY Journey -->
  <section class="mt-16" data-reveal>
    <h2 class="text-3xl font-bold tracking-tight text-white">My Journey</h2>

    <div class="mt-10 relative border-l border-white/10 pl-8 space-y-12">

      <!-- Item -->
      <div class="relative group">
        <div class="absolute -left-[11px] top-2 w-4 h-4 rounded-full bg-sky-400 shadow-lg shadow-sky-400/50 group-hover:scale-125 transition"></div>

        <div class="ml-4">
          <p class="text-sm text-slate-400">2022</p>
          <h3 class="text-xl font-semibold mt-1 text-white group-hover:text-sky-400 transition">
            Started Computer Science
          </h3>
          <p class="text-slate-300 mt-2 leading-relaxed">
            Began my journey at Asia Pacific University of Technology & Innovation (APU), Malaysia.
          </p>
        </div>
      </div>

      <!-- Item -->
      <div class="relative group">
        <div class="absolute -left-[11px] top-2 w-4 h-4 rounded-full bg-sky-400 shadow-lg shadow-sky-400/50 group-hover:scale-125 transition"></div>

        <div class="ml-4">
          <p class="text-sm text-slate-400">2023</p>
          <h3 class="text-xl font-semibold mt-1 text-white group-hover:text-sky-400 transition">
            Moved into Data Analytics
          </h3>
          <p class="text-slate-300 mt-2 leading-relaxed">
            Discovered passion for working with data, analysis, and insights.
          </p>
        </div>
      </div>

      <!-- Item -->
      <div class="relative group">
        <div class="absolute -left-[11px] top-2 w-4 h-4 rounded-full bg-sky-400 shadow-lg shadow-sky-400/50 group-hover:scale-125 transition"></div>

        <div class="ml-4">
          <p class="text-sm text-slate-400">2024</p>
          <h3 class="text-xl font-semibold mt-1 text-white group-hover:text-sky-400 transition">
            Built Real Projects
          </h3>
          <p class="text-slate-300 mt-2 leading-relaxed">
            Developed BI dashboards, fraud detection models, and analytics workflows.
          </p>
        </div>
      </div>

      <!-- Item -->
      <div class="relative group">
        <div class="absolute -left-[11px] top-2 w-4 h-4 rounded-full bg-sky-400 shadow-lg shadow-sky-400/50 group-hover:scale-125 transition"></div>

        <div class="ml-4">
          <p class="text-sm text-slate-400">2025</p>
          <h3 class="text-xl font-semibold mt-1 text-white group-hover:text-sky-400 transition">
            Focused on Decision Systems
          </h3>
          <p class="text-slate-300 mt-2 leading-relaxed">
            Building predictive analytics systems for real-world decision support.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- DIVIDER -->
  <div class="mt-16 border-t border-white/30"></div>

  <!-- SECTION 4: CONTACT CTA -->
  <section class="mt-16 text-center" data-reveal>
    <h2 class="text-2xl font-semibold">Let’s Connect</h2>

    <p class="mt-3 text-slate-300">
      I’m open to Data Analyst roles and collaboration opportunities.
    </p>

    <a
      href="/contact"
      class="inline-block mt-6 rounded-lg bg-sky-400 px-6 py-3 text-sm font-semibold text-slate-950 hover:opacity-90"
    >
      Contact Me
    </a>
  </section>

</Layout>