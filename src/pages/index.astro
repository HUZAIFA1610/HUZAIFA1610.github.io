---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
import { profile } from "../data/profile";
import { caseStudies } from "../data/caseStudies";

const featured = projects.filter((p) => p.featured);
const previewData = Object.fromEntries(
  featured.map((p) => [
    p.slug,
    {
      slug: p.slug,
      title: p.title,
      category: p.category,
      dataset: p.dataset,
      oneLiner: p.oneLiner,
      coverImage: p.coverImage,
      repoUrl: p.repoUrl,
      screenshots: (caseStudies[p.slug]?.screenshots ?? []).map((s) => s.src),
    },
  ])
);
---

<Layout
  title={`${profile.name} | Data Analyst`}
  description={profile.tagline}
>

  <!-- ══════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-10">
    <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sky-400/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-28 h-72 w-72 rounded-full bg-indigo-400/10 blur-3xl"></div>

    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <!-- Text -->
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-sky-200">
            {profile.roleLine}
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1 text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Open to roles
          </span>
          <span class="text-xs rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">
            {profile.location}
          </span>
        </div>

        <h1 class="mt-5 text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.1]">
          BI & Predictive Insights<br class="hidden sm:block" />
          <span class="text-sky-400">for Real-World Decisions.</span>
        </h1>

        <p class="mt-5 text-slate-300 max-w-xl leading-relaxed">
          {profile.tagline}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="rounded-lg bg-sky-400 text-slate-950 px-5 py-2.5 text-sm font-semibold hover:opacity-90 transition-opacity"
            href="/projects"
          >
            View Projects
          </a>
          <a
            class="rounded-lg border border-white/15 px-5 py-2.5 text-sm text-slate-100 hover:bg-white/5 transition-colors"
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Download CV
          </a>
          <a
            class="rounded-lg border border-white/15 px-5 py-2.5 text-sm text-slate-100 hover:bg-white/5 transition-colors"
            href="/contact"
          >
            Contact
          </a>
        </div>
      </div>

      <!-- Headshot -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <div class="absolute -inset-2 rounded-[28px] bg-gradient-to-br from-sky-400/25 via-white/0 to-indigo-400/20 blur"></div>
          <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-black/20 p-2">
            <img
              src={profile.headshot}
              alt={`${profile.name} headshot`}
              class="h-[400px] w-[320px] object-cover rounded-[22px]"
              loading="eager"
              onerror="this.onerror=null;this.src='/images/placeholder.svg';"
            />
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       STATS BAR
  ══════════════════════════════════════════════ -->
  <section class="mt-8" data-reveal>
    <div class="rounded-2xl border border-white/10 overflow-hidden">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 divide-y divide-white/10 sm:divide-y-0 lg:divide-x lg:divide-y-0 sm:[&>*:nth-child(-n+2)]:border-b sm:[&>*:nth-child(-n+2)]:border-white/10">

        <div class="p-6">
          <div class="text-xs uppercase tracking-widest text-slate-500">Projects</div>
          <div class="mt-2 text-3xl font-semibold tracking-tight stat" data-target="10">0</div>
        </div>

        <div class="p-6">
          <div class="text-xs uppercase tracking-widest text-slate-500">Largest Dataset</div>
          <div class="mt-2 text-3xl font-semibold tracking-tight stat" data-target="11830000">0</div>
        </div>

        <div class="p-6">
          <div class="text-xs uppercase tracking-widest text-slate-500">Dashboards</div>
          <div class="mt-2 text-3xl font-semibold tracking-tight text-slate-100">Power BI</div>
        </div>

        <div class="p-6">
          <div class="text-xs uppercase tracking-widest text-slate-500">Status</div>
          <div class="mt-2 flex items-center gap-2 text-base font-semibold text-slate-100">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
            Open to Data Analyst roles
          </div>
        </div>

      </div>
    </div>
    <div class="mt-16 border-t border-white/10"></div>
  </section>


  <!-- ══════════════════════════════════════════════
       EXPERIENCE
  ══════════════════════════════════════════════ -->
  <section class="mt-20" data-reveal>
    <div class="rounded-3xl border border-white/10 bg-slate-900/40 backdrop-blur-sm p-8 sm:p-10">
      <div class="text-center">
        <h2 class="text-2xl font-semibold tracking-tight">Experience</h2>
        <p class="mt-2 text-slate-400 max-w-xl mx-auto text-sm">
          Applied analytics work and leadership — optimized for fast scanning.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <!-- Analytics -->
        <article class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-1 hover:border-sky-400/25 hover:bg-white/8">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-sky-300 transition duration-300 group-hover:scale-110 group-hover:border-sky-400/30 group-hover:shadow-lg group-hover:shadow-sky-400/10">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19V5" /><path d="M4 19H20" /><path d="M8 15l2-2 3 3 5-6" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold">Applied Analytics</h3>
          <p class="mt-2 text-sm text-slate-400">End-to-end analysis and decision support for real datasets and operational workflows.</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-300">
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> Predictive maintenance + risk monitoring</li>
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> Fraud detection + threshold trade-offs</li>
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> EDA across large sales datasets</li>
          </ul>
        </article>

        <!-- BI -->
        <article class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-1 hover:border-sky-400/25 hover:bg-white/8">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-sky-300 transition duration-300 group-hover:scale-110 group-hover:border-sky-400/30 group-hover:shadow-lg group-hover:shadow-sky-400/10">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19V5" /><path d="M8 19V9" /><path d="M12 19V12" /><path d="M16 19V7" /><path d="M20 19V10" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold">Business Intelligence</h3>
          <p class="mt-2 text-sm text-slate-400">KPI storytelling with dashboards, drilldowns, and decision-ready reporting.</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-300">
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> Power BI dashboards for trends</li>
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> MySQL + DAX reporting workflows</li>
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> Global market analysis (Fusion Bikes)</li>
          </ul>
        </article>

        <!-- Leadership -->
        <article class="group rounded-2xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-1 hover:border-sky-400/25 hover:bg-white/8">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-sky-300 transition duration-300 group-hover:scale-110 group-hover:border-sky-400/30 group-hover:shadow-lg group-hover:shadow-sky-400/10">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l9 4.5-9 4.5-9-4.5L12 3Z" />
              <path d="M3 10.5V17l9 4.5 9-4.5v-6.5" />
            </svg>
          </div>
          <h3 class="mt-4 font-semibold">Leadership & Operations</h3>
          <p class="mt-2 text-sm text-slate-400">Team coordination, event execution, and community leadership.</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-300">
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> VP — APU Bangladesh Society</li>
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> Sports Secretary — Bangladesh Org (MY)</li>
            <li class="flex gap-2"><span class="text-sky-400 shrink-0">→</span> Cultural Night ≈ 1,000 attendees</li>
          </ul>
        </article>
      </div>

      <div class="mt-8 text-center">
        <a class="text-sm text-sky-400 hover:underline" href="/about">Read more about me →</a>
      </div>
    </div>
    <div class="mt-16 border-t border-white/10"></div>
  </section>


  <!-- ══════════════════════════════════════════════
       FEATURED PROJECTS
  ══════════════════════════════════════════════ -->
  <section class="mt-20" data-reveal>
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight">Featured Projects</h2>
        <p class="mt-1 text-sm text-slate-400">Three high-impact case studies</p>
      </div>
      <a class="text-sm text-sky-400 hover:underline shrink-0" href="/projects">All projects →</a>
    </div>

    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => (
        <article class="group relative rounded-xl border border-white/10 bg-white/5 hover:bg-white/8 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-400/10">
          <div class="pointer-events-none absolute -inset-16 opacity-0 group-hover:opacity-100 transition duration-300">
            <div class="absolute inset-0 bg-sky-400/10 blur-3xl"></div>
          </div>
          <!-- Cover image -->
          <a href={`/projects/${p.slug}`} class="block">
            <div class="aspect-[16/9] bg-black/30 overflow-hidden">
              <img
                src={p.coverImage}
                alt={`${p.title} cover`}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
                onerror="this.onerror=null;this.src='/images/placeholder.svg';"
              />
            </div>
          </a>

          <!-- Card body -->
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs text-slate-500">{p.category} · {p.dataset}</span>
              <span class="shrink-0 text-[10px] rounded-full border border-sky-400/30 bg-sky-400/10 px-2 py-0.5 text-sky-300 font-medium">
                Featured
              </span>
            </div>

            <a href={`/projects/${p.slug}`} class="mt-2 font-semibold leading-snug hover:text-sky-300 transition-colors">
              {p.title}
            </a>
            <p class="mt-2 text-sm text-slate-400 flex-1">{p.oneLiner}</p>

            {p.proof?.length ? (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {p.proof.slice(0, 3).map((tag) => (
                  <span class="text-[10px] rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-slate-400">
                    {tag}
                  </span>
                ))}
              </div>
            ) : null}
          </div>

          <!-- Card footer — clear primary / secondary CTA -->
          <div class="px-5 pb-5 flex items-center gap-2 mt-auto">
            <a
              class="flex-1 text-center rounded-lg bg-sky-400 text-slate-950 px-4 py-2 text-sm font-semibold hover:opacity-90 transition-opacity"
              href={`/projects/${p.slug}`}
            >
              Case study
            </a>
            <button
              type="button"
              class="rounded-lg border border-white/10 px-3 py-2 text-sm text-slate-300 hover:text-white hover:bg-white/5 transition-colors"
              data-preview-slug={p.slug}
              aria-label={`Quick preview: ${p.title}`}
            >
              Preview
            </button>
            <a
              class="rounded-lg border border-white/10 px-3 py-2 text-sm text-slate-300 hover:text-white hover:bg-white/5 transition-colors"
              href={p.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View on GitHub"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="inline-block">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-16 border-t border-white/10"></div>
  </section>


  <!-- ══════════════════════════════════════════════
       SKILLS
  ══════════════════════════════════════════════ -->
  <section class="mt-20" data-reveal>
    <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-sky-400/5 via-slate-900/60 to-indigo-400/5 p-8 sm:p-10">
      <div class="text-center">
        <h2 class="text-2xl font-semibold tracking-tight">Skills</h2>
        <p class="mt-2 text-slate-400 text-sm max-w-lg mx-auto">
          A focused mix of analytics, BI, modeling, and delivery tools I use to turn data into decisions.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <!-- Summary -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <h3 class="text-lg font-semibold">What I bring</h3>
          <p class="mt-3 text-sm text-slate-300 leading-relaxed">
            I work across data analysis, dashboarding, and predictive modeling to support business decisions.
            My approach combines technical execution with clear reporting and stakeholder-friendly storytelling.
          </p>
          <div class="mt-6 space-y-3 text-sm text-slate-300">
            <div class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-sky-400 shrink-0"></span>
              BI dashboards, KPI storytelling, and reporting
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-sky-400 shrink-0"></span>
              Data cleaning, EDA, segmentation, and insight generation
            </div>
            <div class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-sky-400 shrink-0"></span>
              Predictive modeling, evaluation, and decision support workflows
            </div>
          </div>

          <!-- Tool pills -->
          <div class="mt-6 flex flex-wrap gap-2">
            {profile.coreTools.map((tool) => (
              <span class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-xs text-slate-400">
                {tool}
              </span>
            ))}
          </div>
        </div>

        <!-- Skill bars -->
        <div class="grid gap-4 sm:grid-cols-2">
          {[
            {
              title: "Analytics & BI",
              desc: "Power BI, dashboards, DAX, KPI reporting.",
              skills: [{ name: "Power BI", pct: "90%", level: "Advanced" }, { name: "DAX", pct: "82%", level: "Advanced" }, { name: "KPI Reporting", pct: "88%", level: "Advanced" }],
            },
            {
              title: "Data Analysis",
              desc: "EDA, trend analysis, segmentation with Python/R.",
              skills: [{ name: "Python", pct: "85%", level: "Advanced" }, { name: "R", pct: "68%", level: "Intermediate" }, { name: "EDA", pct: "87%", level: "Advanced" }],
            },
            {
              title: "ML & Modeling",
              desc: "Predictive modeling, evaluation, explainability.",
              skills: [{ name: "Machine Learning", pct: "80%", level: "Advanced" }, { name: "Deep Learning", pct: "66%", level: "Intermediate" }, { name: "Explainability", pct: "72%", level: "Intermediate" }],
            },
            {
              title: "Tools & Delivery",
              desc: "FastAPI, Streamlit, MySQL, Jupyter.",
              skills: [{ name: "FastAPI", pct: "70%", level: "Intermediate" }, { name: "Streamlit", pct: "78%", level: "Advanced" }, { name: "MySQL", pct: "72%", level: "Intermediate" }],
            },
          ].map((card) => (
            <article class="rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:-translate-y-1 hover:border-sky-400/25 hover:bg-white/8 flex flex-col">
              <h3 class="font-semibold text-sm">{card.title}</h3>
              <p class="mt-1 text-xs text-slate-400 mb-4">{card.desc}</p>
              <div class="mt-auto space-y-3 text-xs">
                {card.skills.map((s) => (
                  <div>
                    <div class="mb-1 flex justify-between">
                      <span class="text-slate-200">{s.name}</span>
                      <span class="text-slate-500">{s.level}</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-full bg-white/10">
                      <div class={`h-full bg-sky-400 rounded-full`} style={`width:${s.pct}`}></div>
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-16 border-t border-white/10"></div>
  </section>


  <!-- ══════════════════════════════════════════════
       CONTACT CTA
  ══════════════════════════════════════════════ -->
  <section class="mt-16" data-reveal>
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-slate-900 via-slate-950 to-sky-950/40 px-8 py-10 sm:px-10 sm:py-12 transition duration-300 hover:border-white/20">
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-sky-400/10 blur-3xl"></div>
        <div class="absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-indigo-400/10 blur-3xl"></div>
      </div>

      <div class="relative grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-sky-300/80 font-medium">Contact</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
            Let's build something useful.
          </h2>
          <p class="mt-4 max-w-xl text-slate-300 text-sm leading-relaxed">
            Open to Data Analyst roles, BI work, analytics projects, and meaningful collaboration.
            I respond best to messages that include the role or project context.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-4 py-2 text-sm text-emerald-300">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Available for Data Analyst roles
            </span>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-300">
              Based in Bangladesh
            </span>
          </div>
          <p class="mt-5 text-xs text-slate-500">Typical response time: 24–48 hours.</p>
        </div>

        <div class="lg:border-l lg:border-white/10 lg:pl-10">
          <div class="rounded-2xl border border-white/10 bg-white/5 divide-y divide-white/10 overflow-hidden">
            {[
              { label: "Email", display: profile.email, href: `mailto:${profile.email}` },
              { label: "LinkedIn", display: "View profile", href: profile.links.linkedin },
              { label: "GitHub", display: "View repositories", href: profile.links.github },
              { label: "Resume", display: "Download CV", href: "/resume.pdf" },
              { label: "Meeting", display: "Book a 15-min call", href: profile.links.booking },
            ].map(({ label, display, href }) => (
              <a
                href={href}
                target={href.startsWith("http") || href.endsWith(".pdf") ? "_blank" : undefined}
                rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="group flex items-center justify-between px-4 py-3.5 transition duration-200 hover:bg-white/5"
              >
                <span>
                  <span class="block text-[10px] uppercase tracking-[0.2em] text-slate-500">{label}</span>
                  <span class="mt-0.5 block text-sm text-slate-100">{display}</span>
                </span>
                <span class="text-sky-400 transition duration-200 group-hover:translate-x-1">↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       QUICK-VIEW DIALOG
  ══════════════════════════════════════════════ -->
  <dialog
    id="quickview"
    class="backdrop:bg-black/70 rounded-2xl border border-white/10 bg-slate-950 text-slate-100 w-[min(900px,92vw)]"
  >
    <div class="p-5 sm:p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div id="qv-meta" class="text-xs text-slate-500"></div>
          <h3 id="qv-title" class="mt-2 text-xl font-semibold"></h3>
          <p id="qv-desc" class="mt-2 text-sm text-slate-300"></p>
        </div>
        <button id="qv-close" type="button" class="shrink-0 rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-200 hover:bg-white/5">
          Close
        </button>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <img id="qv-img-1" class="aspect-[16/9] w-full rounded-xl border border-white/10 object-cover bg-black/30" alt="Preview screenshot 1" onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
        <img id="qv-img-2" class="aspect-[16/9] w-full rounded-xl border border-white/10 object-cover bg-black/30" alt="Preview screenshot 2" onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a id="qv-case" class="rounded-lg bg-sky-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:opacity-90" href="#">Open case study</a>
        <a id="qv-github" class="rounded-lg border border-white/10 px-4 py-2 text-sm text-slate-100 hover:bg-white/5" href="#" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>
    </div>
  </dialog>


  <!-- ══════════════════════════════════════════════
       SCRIPTS
  ══════════════════════════════════════════════ -->
  <script is:inline define:vars={{ previewData }}>
    const data = previewData;
    const dlg = document.getElementById("quickview");
    const closeBtn = document.getElementById("qv-close");
    const metaEl = document.getElementById("qv-meta");
    const titleEl = document.getElementById("qv-title");
    const descEl = document.getElementById("qv-desc");
    const img1 = document.getElementById("qv-img-1");
    const img2 = document.getElementById("qv-img-2");
    const caseLink = document.getElementById("qv-case");
    const githubLink = document.getElementById("qv-github");

    function openPreview(slug) {
      const p = data[slug];
      if (!p) return;
      metaEl.textContent = `${p.category} · ${p.dataset}`;
      titleEl.textContent = p.title;
      descEl.textContent = p.oneLiner;
      const shots = (p.screenshots?.length ? p.screenshots : [p.coverImage]).slice(0, 2);
      img1.src = shots[0] || "/images/placeholder.svg";
      img2.src = shots[1] || shots[0] || "/images/placeholder.svg";
      caseLink.href = `/projects/${p.slug}`;
      githubLink.href = p.repoUrl || "#";
      dlg.showModal();
    }

    document.querySelectorAll("[data-preview-slug]").forEach((btn) => {
      btn.addEventListener("click", () => openPreview(btn.getAttribute("data-preview-slug")));
    });
    closeBtn?.addEventListener("click", () => dlg.close());
    dlg?.addEventListener("click", (e) => {
      const rect = dlg.getBoundingClientRect();
      const inDialog = rect.top <= e.clientY && e.clientY <= rect.bottom && rect.left <= e.clientX && e.clientX <= rect.right;
      if (!inDialog) dlg.close();
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && dlg?.open) dlg.close(); });
  </script>

  <script>
    // Animated counters
    const formatNumber = (num: number) => {
      if (num >= 1000000) return (num / 1000000).toFixed(2) + "M";
      if (num >= 1000) return (num / 1000).toFixed(1) + "K";
      return num + "+";
    };

    const runCounter = (counter: Element) => {
      const target = +(counter.getAttribute("data-target") ?? 0);
      let count = 0;
      const update = () => {
        const increment = target / 60;
        if (count < target) {
          count += increment;
          (counter as HTMLElement).innerText = Math.floor(count).toString();
          requestAnimationFrame(update);
        } else {
          (counter as HTMLElement).innerText = formatNumber(target);
        }
      };
      update();
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          runCounter(entry.target);
          observer.unobserve(entry.target);
        }
      });
    });

    document.querySelectorAll(".stat").forEach((counter) => observer.observe(counter));
  </script>

</Layout>