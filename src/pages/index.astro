---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects";
import { profile } from "../data/profile";
import { caseStudies } from "../data/caseStudies";

const featured = projects.filter((p) => p.featured);
const previewData = Object.fromEntries(
  featured.map((p) => [
    p.slug,
    {
      slug: p.slug,
      title: p.title,
      category: p.category,
      dataset: p.dataset,
      oneLiner: p.oneLiner,
      coverImage: p.coverImage,
      screenshots: (caseStudies[p.slug]?.screenshots ?? []).map((s) => s.src),
    },
  ])
);
---

<Layout
  title={`${profile.name} | Data Analyst`}
    description={profile.tagline}
  >
  <section class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-10">
    <!-- subtle corporate glow -->
    <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sky-400/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-28 h-72 w-72 rounded-full bg-indigo-400/10 blur-3xl"></div>

    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <!-- LEFT: text -->
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-1 text-sky-200">
            {profile.roleLine}
          </span>
          <span class="text-xs rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">
            Open to roles
          </span>
          <span class="text-xs rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">
            {profile.location}
          </span>
        </div>

        <h1 class="mt-4 text-4xl sm:text-5xl font-semibold tracking-tight">
          BI & Predictive Insights for Real-World Decisions.
        </h1>

        <p class="mt-4 text-slate-300 max-w-2xl leading-relaxed">
          {profile.tagline}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            class="rounded-lg bg-sky-400 text-slate-950 px-4 py-2 text-sm font-semibold hover:opacity-90"
            href="/projects"
          >
            View Projects
          </a>

          <a
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-slate-100 hover:bg-white/5"
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Download CV
          </a>

          <a
            class="rounded-lg border border-white/10 px-4 py-2 text-sm text-slate-100 hover:bg-white/5"
            href="/contact"
          >
            Contact
          </a>
        </div>
      </div>

      <!-- RIGHT: headshot -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <div class="absolute -inset-2 rounded-[28px] bg-gradient-to-br from-sky-400/25 via-white/0 to-indigo-400/20 blur"></div>

          <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-black/20 p-2">
            <img
              src={profile.headshot}
              alt={`${profile.name} headshot`}
              class="h-[420px] w-[340px] object-cover rounded-[22px]"
              loading="eager"
              onerror="this.onerror=null;this.src='/images/placeholder.svg';"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-6">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {profile.stats.map((s) => (
        <div class="rounded-xl border border-white/10 bg-white/5 p-4">
          <div class="text-sm text-slate-400">{s.label}</div>
          <div class="mt-1 text-xl font-semibold">{s.value}</div>
        </div>
      ))}

      <div class="rounded-xl border border-sky-400/20 bg-sky-400/5 p-4">
        <div class="text-sm text-slate-400">Status</div>
        <div class="mt-1 text-sm text-slate-200">
          <span class="inline-flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-sky-400"></span>
            Open to Data Analyst roles
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Experience</h2>
    <p class="mt-2 text-slate-300 max-w-2xl">
      A quick overview of applied analytics, BI work, and leadership experience that supports my Data Analyst profile.
    </p>

    <div class="mt-4 grid gap-4 lg:grid-cols-3">
      <div class="rounded-xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm text-slate-400">Applied Analytics Projects</div>
        <h3 class="mt-2 font-semibold">End-to-end analysis & decision support</h3>
        <ul class="mt-3 space-y-2 text-slate-300">
          <li class="list-disc ml-5">Predictive maintenance and risk monitoring workflows</li>
          <li class="list-disc ml-5">Fraud detection evaluation and threshold trade-off analysis</li>
          <li class="list-disc ml-5">Exploratory analysis across large transaction and sales datasets</li>
        </ul>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm text-slate-400">Business Intelligence & Reporting</div>
        <h3 class="mt-2 font-semibold">Dashboarding and KPI storytelling</h3>
        <ul class="mt-3 space-y-2 text-slate-300">
          <li class="list-disc ml-5">Power BI dashboards for sales trends and performance insights</li>
          <li class="list-disc ml-5">MySQL + DAX-based reporting workflows</li>
          <li class="list-disc ml-5">Executive-friendly views for monitoring and decision support</li>
        </ul>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm text-slate-400">Leadership & Operations</div>
        <h3 class="mt-2 font-semibold">Team coordination and event execution</h3>
        <ul class="mt-3 space-y-2 text-slate-300">
          <li class="list-disc ml-5">Vice President — APU Bangladesh Society</li>
          <li class="list-disc ml-5">Sports Secretary — Bangladesh Student Organisation of Malaysia</li>
          <li class="list-disc ml-5">Led multi-team events (100–1000 attendees / participants)</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mt-12">
    <div class="text-center">
      <h2 class="text-2xl font-semibold tracking-tight">Areas of Interest</h2>
      <p class="mt-2 text-slate-300">
        What I can deliver in a Data Analyst role — clean insights, clear reporting, and decision support.
      </p>
    </div>

    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- 1 -->
      <article class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-sky-300">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" class="opacity-90" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19V5" /><path d="M4 19H20" />
            <path d="M8 15l2-2 3 3 5-6" />
          </svg>
        </div>
        <h3 class="mt-4 font-semibold">BI Dashboard Development</h3>
        <p class="mt-2 text-sm text-slate-300">
          Power BI dashboards with KPI storytelling, drill-down analysis, and executive-ready views.
        </p>

        <details class="mt-3 inline-block text-left">
          <summary class="cursor-pointer text-sm text-sky-300 hover:underline">Deliverables</summary>
          <ul class="mt-2 space-y-1 text-sm text-slate-300">
            <li class="list-disc ml-5">KPI dashboard pages</li>
            <li class="list-disc ml-5">DAX measures + drilldowns</li>
            <li class="list-disc ml-5">Insights summary</li>
          </ul>
        </details>
      </article>

      <!-- 2 -->
      <article class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-sky-300">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" class="opacity-90" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18" /><path d="M7 12h10" /><path d="M10 18h4" />
          </svg>
        </div>
        <h3 class="mt-4 font-semibold">Data Cleaning & Analysis</h3>
        <p class="mt-2 text-sm text-slate-300">
          EDA, trend analysis, segmentation, and insight generation using Python/R.
        </p>

        <details class="mt-3 inline-block text-left">
          <summary class="cursor-pointer text-sm text-sky-300 hover:underline">Deliverables</summary>
          <ul class="mt-2 space-y-1 text-sm text-slate-300">
            <li class="list-disc ml-5">Cleaned dataset + notebook</li>
            <li class="list-disc ml-5">Key insights + charts</li>
            <li class="list-disc ml-5">Recommendations</li>
          </ul>
        </details>
      </article>

      <!-- 3 -->
      <article class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-sky-300">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" class="opacity-90" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v6" /><path d="M12 16v6" />
            <path d="M4.9 4.9l4.2 4.2" /><path d="M14.9 14.9l4.2 4.2" />
            <path d="M2 12h6" /><path d="M16 12h6" />
            <path d="M4.9 19.1l4.2-4.2" /><path d="M14.9 9.1l4.2-4.2" />
          </svg>
        </div>
        <h3 class="mt-4 font-semibold">Predictive Analytics</h3>
        <p class="mt-2 text-sm text-slate-300">
          Model prototypes, evaluation trade-offs, and interpretable outputs for decisions.
        </p>

        <details class="mt-3 inline-block text-left">
          <summary class="cursor-pointer text-sm text-sky-300 hover:underline">Deliverables</summary>
          <ul class="mt-2 space-y-1 text-sm text-slate-300">
            <li class="list-disc ml-5">Model comparison</li>
            <li class="list-disc ml-5">Explainability summary</li>
            <li class="list-disc ml-5">Deployment-ready outputs</li>
          </ul>
        </details>
      </article>

      <!-- 4 -->
      <article class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-sky-300">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" class="opacity-90" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19V5" /><path d="M8 19V9" /><path d="M12 19V12" /><path d="M16 19V7" /><path d="M20 19V10" />
          </svg>
        </div>
        <h3 class="mt-4 font-semibold">KPI Reporting</h3>
        <p class="mt-2 text-sm text-slate-300">
          Structured reporting for monitoring performance, gaps, and opportunities.
        </p>

        <details class="mt-3 inline-block text-left">
          <summary class="cursor-pointer text-sm text-sky-300 hover:underline">Deliverables</summary>
          <ul class="mt-2 space-y-1 text-sm text-slate-300">
            <li class="list-disc ml-5">KPI definitions</li>
            <li class="list-disc ml-5">Monthly/weekly reporting</li>
            <li class="list-disc ml-5">Actionable insights</li>
          </ul>
        </details>
      </article>

      <!-- 5 -->
      <article class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-sky-300">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" class="opacity-90" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7c0-2 4-3 8-3s8 1 8 3-4 3-8 3-8-1-8-3Z" />
            <path d="M4 7v10c0 2 4 3 8 3s8-1 8-3V7" />
            <path d="M4 12c0 2 4 3 8 3s8-1 8-3" />
          </svg>
        </div>
        <h3 class="mt-4 font-semibold">SQL & Data Pipelines</h3>
        <p class="mt-2 text-sm text-slate-300">
          Querying, transformations, and dataset preparation for analytics and BI.
        </p>

        <details class="mt-3 inline-block text-left">
          <summary class="cursor-pointer text-sm text-sky-300 hover:underline">Deliverables</summary>
          <ul class="mt-2 space-y-1 text-sm text-slate-300">
            <li class="list-disc ml-5">SQL queries / views</li>
            <li class="list-disc ml-5">Clean tables for BI</li>
            <li class="list-disc ml-5">Documentation</li>
          </ul>
        </details>
      </article>

      <!-- 6 -->
      <article class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/5 text-sky-300">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" class="opacity-90" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16v10H4z" />
            <path d="M8 20h8" />
            <path d="M10 16v4" />
          </svg>
        </div>
        <h3 class="mt-4 font-semibold">Analytics Apps (FastAPI + Streamlit)</h3>
        <p class="mt-2 text-sm text-slate-300">
          Lightweight dashboards and APIs for internal tools, demos, and decision support.
        </p>

        <details class="mt-3 inline-block text-left">
          <summary class="cursor-pointer text-sm text-sky-300 hover:underline">Deliverables</summary>
          <ul class="mt-2 space-y-1 text-sm text-slate-300">
            <li class="list-disc ml-5">Streamlit UI</li>
            <li class="list-disc ml-5">FastAPI endpoints</li>
            <li class="list-disc ml-5">Swagger docs</li>
          </ul>
        </details>
      </article>
    </div>

    <div class="mt-8 text-center">
      <a class="text-sm text-sky-400 hover:underline" href="/skills">View full skills →</a>
    </div>
  </section>

  <section class="mt-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold">Spotlight</h2>
        <p class="mt-1 text-sm text-slate-400">Three high-impact case studies</p>
      </div>

      <a class="text-sm text-sky-400 hover:underline" href="/projects">All projects →</a>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => (
        <article class="group rounded-2xl border border-white/10 bg-white/5 overflow-hidden hover:bg-white/10 transition">
          <a href={`/projects/${p.slug}`} class="block">
            <div class="aspect-[16/9] bg-black/30 overflow-hidden">
              <img
                src={p.coverImage}
                alt={`${p.title} cover`}
                class="h-full w-full object-cover opacity-90 group-hover:opacity-100 transition"
                loading="lazy"
                onerror="this.onerror=null;this.src='/images/placeholder.svg';"
              />
            </div>

            <div class="p-5">
              <div class="flex items-center justify-between gap-3">
                <div class="text-xs text-slate-400">{p.category} • {p.dataset}</div>
                <span class="text-[11px] rounded-full border border-sky-400/30 bg-sky-400/10 px-2 py-1 text-sky-200">
                  Featured
                </span>
              </div>

              <div class="mt-2 font-semibold">{p.title}</div>
              <div class="mt-2 text-sm text-slate-300">{p.oneLiner}</div>
            </div>
          </a>

          <div class="px-5 pb-5 flex gap-3">
            <a class="text-sm text-sky-400 hover:underline" href={`/projects/${p.slug}`}>
              Case study →
            </a>

            <button
              type="button"
              class="text-sm text-slate-300 hover:text-white"
              data-preview-slug={p.slug}
            >
              Preview →
            </button>

            <a class="text-sm text-slate-300 hover:text-white" href={p.repoUrl} target="_blank" rel="noopener noreferrer">
              GitHub →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">Highlights</h2>

    <div class="mt-4 grid gap-4 lg:grid-cols-3">
      <div class="rounded-xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm text-slate-400">Focus</div>
        <ul class="mt-3 space-y-2 text-slate-300">
          <li class="list-disc ml-5">BI dashboards & KPI storytelling</li>
          <li class="list-disc ml-5">EDA, trend analysis, reporting</li>
          <li class="list-disc ml-5">Decision-support workflows (API + UI)</li>
        </ul>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm text-slate-400">Core tools</div>
        <div class="mt-3 flex flex-wrap gap-2">
          {profile.coreTools.map((t) => (
            <span class="text-xs rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">{t}</span>
          ))}

        </div>
      </div>

      <div class="rounded-xl border border-white/10 bg-white/5 p-6">
        <div class="text-sm text-slate-400">Quick stats</div>
        <div class="mt-4 grid grid-cols-3 gap-3">
          {profile.stats.map((s) => (
            <div class="rounded-lg border border-white/10 bg-black/20 p-3 text-center">
              <div class="text-lg font-semibold">{s.value}</div>
              <div class="text-xs text-slate-400">{s.label}</div>
            </div>
          ))}
        </div>


        <p class="mt-4 text-sm text-slate-300">
          Want the details? Explore the <a class="text-sky-400 hover:underline" href="/projects">case studies</a>.
        </p>
      </div>
    </div>
  </section>

  <dialog
    id="quickview"
    class="backdrop:bg-black/70 rounded-2xl border border-white/10 bg-slate-950 text-slate-100 w-[min(900px,92vw)]"
  >
    <div class="p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4">
        <div>
          <div id="qv-meta" class="text-xs text-slate-400"></div>
          <h3 id="qv-title" class="mt-2 text-2xl font-semibold"></h3>
          <p id="qv-desc" class="mt-2 text-slate-300"></p>
        </div>

        <button
          id="qv-close"
          type="button"
          class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-200 hover:bg-white/5"
        >
          Close
        </button>
      </div>

      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <img
          id="qv-img-1"
          class="aspect-[16/9] w-full rounded-xl border border-white/10 object-cover bg-black/30"
          alt="Preview screenshot 1"
          onerror="this.onerror=null;this.src='/images/placeholder.svg';"
        />
        <img
          id="qv-img-2"
          class="aspect-[16/9] w-full rounded-xl border border-white/10 object-cover bg-black/30"
          alt="Preview screenshot 2"
          onerror="this.onerror=null;this.src='/images/placeholder.svg';"
        />
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          id="qv-case"
          class="rounded-lg bg-sky-400 px-4 py-2 text-sm font-semibold text-slate-950 hover:opacity-90"
          href="#"
        >
          Open case study
        </a>

        <a
          id="qv-github"
          class="rounded-lg border border-white/10 px-4 py-2 text-sm text-slate-100 hover:bg-white/5"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </dialog>

  <script define:vars={{ previewData }}>
    const data = previewData;

    const dlg = document.getElementById("quickview");
    const closeBtn = document.getElementById("qv-close");

    const metaEl = document.getElementById("qv-meta");
    const titleEl = document.getElementById("qv-title");
    const descEl = document.getElementById("qv-desc");

    const img1 = document.getElementById("qv-img-1");
    const img2 = document.getElementById("qv-img-2");

    const caseLink = document.getElementById("qv-case");
    const githubLink = document.getElementById("qv-github");

    function openPreview(slug) {
      const p = data[slug];
      if (!p) return;

      metaEl.textContent = `${p.category} • ${p.dataset}`;
      titleEl.textContent = p.title;
      descEl.textContent = p.oneLiner;

      const shots = (p.screenshots && p.screenshots.length ? p.screenshots : [p.coverImage]).slice(0, 2);
      img1.src = shots[0] || "/images/placeholder.svg";
      img2.src = shots[1] || shots[0] || "/images/placeholder.svg";

      caseLink.href = `/projects/${p.slug}`;
      githubLink.href = p.repoUrl || "#";

      dlg.showModal();
    }

    document.querySelectorAll("[data-preview-slug]").forEach((btn) => {
      btn.addEventListener("click", () => openPreview(btn.getAttribute("data-preview-slug")));
    });

    closeBtn?.addEventListener("click", () => dlg.close());

    dlg?.addEventListener("click", (e) => {
      const rect = dlg.getBoundingClientRect();
      const inDialog =
        rect.top <= e.clientY && e.clientY <= rect.bottom && rect.left <= e.clientX && e.clientX <= rect.right;
      if (!inDialog) dlg.close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && dlg?.open) dlg.close();
    });
  </script>

</Layout>