---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import { caseStudies } from "../../data/caseStudies";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = projects.find((p) => p.slug === slug);

if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const cs = caseStudies[slug] ?? null;
---

<Layout title={`${project.title} | Mohammad Abu Huzaifa`} description={project.oneLiner}>
  <div class="flex items-center justify-between gap-4">
    <a href="/projects" class="text-sm text-sky-400 hover:underline">← Back to Projects</a>
    <div class="flex gap-3">
      <a
        class="rounded-lg bg-sky-400 text-slate-950 px-4 py-2 text-sm font-semibold hover:opacity-90"
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        View on GitHub
      </a>
      {project.demoUrl ? (
        <a
          class="rounded-lg border border-white/10 px-4 py-2 text-sm text-slate-100 hover:bg-white/5"
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Live Demo
        </a>
      ) : null}
      <a
        class="rounded-lg border border-white/10 px-4 py-2 text-sm text-slate-100 hover:bg-white/5"
        href="/contact"
      >
        Contact
      </a>
    </div>
  </div>

  <div class="mt-4">
    <div class="text-sm text-slate-400">{project.category} • {project.dataset}</div>
    <h1 class="mt-2 text-3xl sm:text-4xl font-semibold tracking-tight">{project.title}</h1>
    <p class="mt-3 text-slate-300 max-w-3xl leading-relaxed">{project.oneLiner}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {project.stack.map((t) => (
        <span class="text-xs rounded-full border border-white/10 bg-white/5 px-3 py-1 text-slate-300">{t}</span>
      ))}
    </div>
  </div>

  <div class="mt-8 rounded-xl border border-white/10 bg-white/5 overflow-hidden">
    <div class="aspect-[16/9] bg-black/30">
      <img
        src={project.coverImage}
        alt={`${project.title} cover`}
        class="h-full w-full object-cover opacity-90"
        loading="lazy"
        onerror="this.onerror=null;this.src='/images/placeholder.svg';"
      />
    </div>
  </div>

  {cs ? (
    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      <!-- MAIN CONTENT -->
      <section class="lg:col-span-2 space-y-10">
        <section id="overview" class="scroll-mt-28 rounded-xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-xl font-semibold">Executive summary</h2>
          <p class="mt-2 text-slate-300 leading-relaxed">{cs.executiveSummary}</p>
        </section>

        <section id="problem" class="scroll-mt-28">
          <h2 class="text-xl font-semibold">Problem</h2>
          <ul class="mt-3 space-y-2 text-slate-300">
            {cs.problem.map((x) => (<li class="list-disc ml-5">{x}</li>))}
          </ul>
        </section>

        <section id="data" class="scroll-mt-28">
          <h2 class="text-xl font-semibold">Data</h2>
          <div class="mt-3 rounded-xl border border-white/10 bg-white/5 p-6 text-slate-300">
            <div class="text-sm text-slate-400">Scale</div>
            <div class="mt-1 font-semibold text-slate-100">{cs.data.scale}</div>

            {cs.data.sources ? (
              <>
                <div class="mt-4 text-sm text-slate-400">Sources</div>
                <ul class="mt-2 space-y-1">
                  {cs.data.sources.map((x) => (<li class="list-disc ml-5">{x}</li>))}
                </ul>
              </>
            ) : null}

            {cs.data.features ? (
              <>
                <div class="mt-4 text-sm text-slate-400">Key features</div>
                <ul class="mt-2 space-y-1">
                  {cs.data.features.map((x) => (<li class="list-disc ml-5">{x}</li>))}
                </ul>
              </>
            ) : null}

            {cs.data.notes ? (
              <>
                <div class="mt-4 text-sm text-slate-400">Notes</div>
                <ul class="mt-2 space-y-1">
                  {cs.data.notes.map((x) => (<li class="list-disc ml-5">{x}</li>))}
                </ul>
              </>
            ) : null}
          </div>
        </section>

        <section id="approach" class="scroll-mt-28">
          <h2 class="text-xl font-semibold">Approach</h2>
          <ul class="mt-3 space-y-2 text-slate-300">
            {cs.approach.map((x) => (<li class="list-disc ml-5">{x}</li>))}
          </ul>
        </section>

        <section id="insights" class="scroll-mt-28">
          <h2 class="text-xl font-semibold">Insights</h2>
          <ul class="mt-3 space-y-2 text-slate-300">
            {cs.insights.map((x) => (<li class="list-disc ml-5">{x}</li>))}
          </ul>
        </section>

        <section id="impact" class="scroll-mt-28">
          <h2 class="text-xl font-semibold">Impact</h2>
          <ul class="mt-3 space-y-2 text-slate-300">
            {cs.impact.map((x) => (<li class="list-disc ml-5">{x}</li>))}
          </ul>
        </section>

        {cs.screenshots?.length ? (
          <section id="screenshots" class="scroll-mt-28">
            <h2 class="text-xl font-semibold">Screenshots</h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {cs.screenshots.map((s) => (
                <figure class="rounded-xl border border-white/10 bg-white/5 overflow-hidden">
                  <div class="aspect-[16/9] bg-black/30">
                    <img
                      src={s.src}
                      alt={s.alt}
                      data-lightbox="true"
                      data-caption={s.caption ?? ""}
                      class="h-full w-full object-cover opacity-90"
                      loading="lazy"
                      onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                    />
                  </div>
                  {s.caption ? (
                    <figcaption class="p-4 text-sm text-slate-300">{s.caption}</figcaption>
                  ) : null}
                </figure>
              ))}
            </div>
          </section>
        ) : null}
      </section>

      <!-- STICKY SIDEBAR -->
      <aside class="lg:sticky lg:top-24 h-fit space-y-6">
        <nav class="hidden lg:block rounded-xl border border-white/10 bg-white/5 p-5">
          <h3 class="text-sm font-semibold text-slate-200">On this page</h3>

          <div class="mt-3 space-y-1">
            <a class="toc-link block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" href="#overview">Executive summary</a>
            <a class="toc-link block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" href="#problem">Problem</a>
            <a class="toc-link block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" href="#data">Data</a>
            <a class="toc-link block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" href="#approach">Approach</a>
            <a class="toc-link block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" href="#insights">Insights</a>
            <a class="toc-link block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" href="#impact">Impact</a>
            {cs.screenshots?.length ? (
              <a class="toc-link block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white" href="#screenshots">Screenshots</a>
            ) : null}
          </div>
        </nav>

        <section id="tools" class="scroll-mt-28 rounded-xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-lg font-semibold">Tools</h2>
          <ul class="mt-3 space-y-2 text-slate-300">
            {cs.tools.map((x) => (<li class="list-disc ml-5">{x}</li>))}
          </ul>

          {cs.next?.length ? (
            <>
              <h2 class="mt-8 text-lg font-semibold">Next improvements</h2>
              <ul class="mt-3 space-y-2 text-slate-300">
                {cs.next.map((x) => (<li class="list-disc ml-5">{x}</li>))}
              </ul>
            </>
          ) : null}
        </section>
      </aside>
    </div>

    <script is:inline>
      /** @type {HTMLAnchorElement[]} */
      const tocLinks = Array.from(document.querySelectorAll(".toc-link"));

      const sectionIds = tocLinks
        .map((a) => a.getAttribute("href")?.slice(1))
        .filter((x) => typeof x === "string" && x.length > 0);

      /** @type {HTMLElement[]} */
      const sections = sectionIds
        .map((id) => document.getElementById(id))
        .filter((el) => el instanceof HTMLElement);

      /** @param {string} id */
      function setActive(id) {
        tocLinks.forEach((a) => {
          const isActive = a.getAttribute("href") === `#${id}`;
          a.classList.toggle("bg-white/10", isActive);
          a.classList.toggle("text-white", isActive);
          a.classList.toggle("border", isActive);
          a.classList.toggle("border-white/10", isActive);
        });
      }

      if ("IntersectionObserver" in window && sections.length) {
        const io = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => (a.boundingClientRect.top ?? 0) - (b.boundingClientRect.top ?? 0))[0];

            const id = visible?.target && "id" in visible.target ? visible.target.id : "";
            if (id) setActive(id);
          },
          { threshold: 0.2, rootMargin: "-20% 0px -65% 0px" }
        );

        sections.forEach((s) => io.observe(s));
        setActive(sections[0].id);
      }
    </script>
  ) : (
    <div class="mt-10 rounded-xl border border-white/10 bg-white/5 p-6 text-slate-300">
      Detailed case study coming soon. For now, check the GitHub repository for full implementation details.
    </div>
  )}
</Layout>