---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";

const skillCategories = [
  {
    id: "bi",
    label: "Analytics & BI",
    icon: `<path d="M4 19V5"/><path d="M4 19H20"/><path d="M8 15l2-2 3 3 5-6"/>`,
    color: "sky",
    summary: "Translating raw data into executive-ready dashboards and KPI frameworks.",
    skills: [
      { name: "Power BI", level: "Advanced", pct: 90, note: "Multi-page dashboards, drill-downs, bookmarks" },
      { name: "DAX", level: "Advanced", pct: 82, note: "Measures, calculated columns, time intelligence" },
      { name: "KPI Reporting", level: "Advanced", pct: 88, note: "Metric definitions, scorecards, executive views" },
      { name: "Data Storytelling", level: "Advanced", pct: 85, note: "Narrative structure, visual hierarchy, stakeholder framing" },
    ],
  },
  {
    id: "analysis",
    label: "Data Analysis",
    icon: `<path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/>`,
    color: "indigo",
    summary: "Exploratory analysis, trend discovery, and insight generation across large datasets.",
    skills: [
      { name: "Python", level: "Advanced", pct: 85, note: "Pandas, NumPy, Matplotlib, Seaborn" },
      { name: "R", level: "Intermediate", pct: 68, note: "ggplot2, dplyr, time series" },
      { name: "EDA", level: "Advanced", pct: 87, note: "Distributions, correlations, outlier detection" },
      { name: "SQL / MySQL", level: "Intermediate", pct: 75, note: "Joins, CTEs, window functions, views" },
    ],
  },
  {
    id: "ml",
    label: "Applied ML",
    icon: `<path d="M12 2v6"/><path d="M12 16v6"/><path d="M4.9 4.9l4.2 4.2"/><path d="M14.9 14.9l4.2 4.2"/><path d="M2 12h6"/><path d="M16 12h6"/><path d="M4.9 19.1l4.2-4.2"/><path d="M14.9 9.1l4.2-4.2"/>`,
    color: "violet",
    summary: "Predictive modeling pipelines with explainability and business-aligned evaluation.",
    skills: [
      { name: "Machine Learning", level: "Advanced", pct: 80, note: "Scikit-learn, XGBoost, cross-validation" },
      { name: "Deep Learning", level: "Intermediate", pct: 66, note: "TensorFlow/Keras, neural architectures" },
      { name: "Explainability", level: "Intermediate", pct: 72, note: "SHAP, Integrated Gradients, feature importance" },
      { name: "Model Evaluation", level: "Advanced", pct: 83, note: "PR-AUC, ROC, threshold tuning, confusion matrix" },
    ],
  },
  {
    id: "delivery",
    label: "Tools & Delivery",
    icon: `<path d="M4 6h16v10H4z"/><path d="M8 20h8"/><path d="M10 16v4"/>`,
    color: "emerald",
    summary: "End-to-end deployment of analytics apps and APIs with clean documentation.",
    skills: [
      { name: "FastAPI", level: "Intermediate", pct: 70, note: "REST endpoints, Swagger docs, async routes" },
      { name: "Streamlit", level: "Advanced", pct: 78, note: "Interactive dashboards, model UIs" },
      { name: "Jupyter / Colab", level: "Advanced", pct: 90, note: "Notebook-driven analysis and reporting" },
      { name: "Excel", level: "Advanced", pct: 82, note: "Pivot tables, VLOOKUP, data validation" },
    ],
  },
];

const colorMap: Record<string, { accent: string; border: string; bg: string; bar: string; badge: string; badgeText: string }> = {
  sky:     { accent: "text-sky-300",    border: "border-sky-400/20",    bg: "bg-sky-400/8",    bar: "bg-sky-400",    badge: "bg-sky-400/15 border-sky-400/25",    badgeText: "text-sky-300" },
  indigo:  { accent: "text-indigo-300", border: "border-indigo-400/20", bg: "bg-indigo-400/8", bar: "bg-indigo-400", badge: "bg-indigo-400/15 border-indigo-400/25", badgeText: "text-indigo-300" },
  violet:  { accent: "text-violet-300", border: "border-violet-400/20", bg: "bg-violet-400/8", bar: "bg-violet-400", badge: "bg-violet-400/15 border-violet-400/25", badgeText: "text-violet-300" },
  emerald: { accent: "text-emerald-300", border: "border-emerald-400/20", bg: "bg-emerald-400/8", bar: "bg-emerald-400", badge: "bg-emerald-400/15 border-emerald-400/25", badgeText: "text-emerald-300" },
};

const softSkills = [
  { label: "Data storytelling", icon: "📊" },
  { label: "Stakeholder reporting", icon: "📋" },
  { label: "Problem decomposition", icon: "🔍" },
  { label: "Decision-first thinking", icon: "🎯" },
  { label: "Cross-functional comms", icon: "🤝" },
  { label: "Self-directed learning", icon: "📚" },
];
---

<Layout
  title={`Skills | ${profile.name}`}
  description={`${profile.roleLine} — skills, tools, and strengths.`}
>

  <!-- ══════════════════════════════════════════════
       PAGE HEADER
  ══════════════════════════════════════════════ -->
  <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] px-8 py-10 sm:px-12 sm:py-12" data-reveal>
    <div class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-sky-400/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-indigo-400/8 blur-3xl"></div>

    <div class="relative max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-sky-400/70">Capabilities</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Skills & Tools
      </h1>
      <p class="mt-4 text-slate-400 leading-relaxed">
        A recruiter-friendly breakdown of my analytics toolkit — from BI dashboards and EDA
        to predictive modeling and deployed data apps.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {["Python", "Power BI", "SQL", "Machine Learning", "FastAPI", "Streamlit"].map((t) => (
          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-400">{t}</span>
        ))}
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-500">+more</span>
      </div>
    </div>
  </div>


  <!-- ══════════════════════════════════════════════
       SKILL CATEGORY CARDS
  ══════════════════════════════════════════════ -->
  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {skillCategories.map((cat, i) => {
      const c = colorMap[cat.color];
      return (
        <section
          class="group rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-300 hover:border-white/20 hover:bg-white/[0.06]"
          data-reveal
          style={`animation-delay: ${i * 80}ms`}
        >
          <!-- Card header -->
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border ${c.border} ${c.bg} ${c.accent} transition duration-300 group-hover:scale-110`}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
              </div>
              <h2 class="font-semibold text-slate-100">{cat.label}</h2>
            </div>
            <span class={`shrink-0 rounded-full border px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wider ${c.badge} ${c.badgeText}`}>
              {cat.skills.length} skills
            </span>
          </div>

          <p class="mt-3 text-sm text-slate-400 leading-relaxed">{cat.summary}</p>

          <!-- Skill bars -->
          <div class="mt-5 space-y-4">
            {cat.skills.map((s) => (
              <div>
                <div class="flex items-baseline justify-between gap-2 mb-1.5">
                  <span class="text-sm text-slate-200 font-medium">{s.name}</span>
                  <span class="text-[10px] text-slate-500 shrink-0">{s.level}</span>
                </div>
                <div class="h-1.5 overflow-hidden rounded-full bg-white/8">
                  <div
                    class={`skill-bar h-full rounded-full ${c.bar}`}
                    style={`width: 0%; --target-width: ${s.pct}%`}
                  ></div>
                </div>
                <p class="mt-1 text-[11px] text-slate-500">{s.note}</p>
              </div>
            ))}
          </div>
        </section>
      );
    })}
  </div>


  <!-- ══════════════════════════════════════════════
       CORE TOOLS GRID
  ══════════════════════════════════════════════ -->
  <section class="mt-10 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8" data-reveal>
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <h2 class="font-semibold text-slate-100">Core Tools</h2>
        <p class="mt-0.5 text-sm text-slate-500">Everything I reach for day-to-day</p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      {profile.coreTools.map((t) => (
        <span class="group flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-slate-300 transition duration-200 hover:border-sky-400/30 hover:bg-sky-400/8 hover:text-sky-200 cursor-default">
          {t}
        </span>
      ))}
    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       SOFT SKILLS
  ══════════════════════════════════════════════ -->
  <section class="mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8" data-reveal>
    <h2 class="font-semibold text-slate-100">Professional Strengths</h2>
    <p class="mt-0.5 text-sm text-slate-500">The non-technical side that makes analytics land</p>

    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {softSkills.map(({ label, icon }) => (
        <div class="flex items-center gap-3 rounded-xl border border-white/8 bg-white/[0.02] px-4 py-3 transition duration-200 hover:border-white/15 hover:bg-white/5">
          <span class="text-lg" aria-hidden="true">{icon}</span>
          <span class="text-sm text-slate-300">{label}</span>
        </div>
      ))}
    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       PROOF CTA
  ══════════════════════════════════════════════ -->
  <section class="mt-6 rounded-2xl border border-sky-400/15 bg-sky-400/5 px-6 py-5 sm:px-8 sm:py-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4" data-reveal>
    <div>
      <h2 class="font-semibold text-slate-100">Want to see these skills in action?</h2>
      <p class="mt-1 text-sm text-slate-400">
        Explore the case studies for real dashboards, analysis notebooks, and deployed workflows.
      </p>
    </div>
    <a
      href="/projects"
      class="shrink-0 rounded-lg bg-sky-400 px-5 py-2.5 text-sm font-semibold text-slate-950 hover:opacity-90 transition-opacity text-center"
    >
      View Projects →
    </a>
  </section>


  <!-- ══════════════════════════════════════════════
       SKILL BAR ANIMATION SCRIPT
  ══════════════════════════════════════════════ -->
  <script>
    const bars = document.querySelectorAll<HTMLElement>(".skill-bar");

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = el.style.getPropertyValue("--target-width");
            // Small delay so reveal animation plays first
            setTimeout(() => {
              el.style.transition = "width 0.9s cubic-bezier(0.4, 0, 0.2, 1)";
              el.style.width = target;
            }, 150);
            io.unobserve(el);
          }
        });
      },
      { threshold: 0.3 }
    );

    bars.forEach((bar) => io.observe(bar));
  </script>

</Layout>