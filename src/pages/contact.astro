---
import Layout from "../layouts/Layout.astro";
import { profile } from "../data/profile";

const bookingLink = (profile.links.booking ?? "").trim();
const hasRealBookingLink =
  bookingLink.length > 0 &&
  !bookingLink.includes("your-username") &&
  !bookingLink.includes("example.com");

const channels = [
  {
    label: "LinkedIn",
    desc: "Recruiter-friendly summary, experience, and endorsements.",
    href: profile.links.linkedin,
    external: true,
    icon: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>`,
  },
  {
    label: "GitHub",
    desc: "Code, notebooks, dashboards, and case studies.",
    href: profile.links.github,
    external: true,
    icon: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>`,
  },
  ...(hasRealBookingLink ? [{
    label: "Book a call",
    desc: "30-minute portfolio review or project discussion.",
    href: bookingLink,
    external: true,
    icon: `<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>`,
  }] : []),
];
---

<Layout
  title={`Contact | ${profile.name}`}
  description={`Contact ${profile.name} — ${profile.roleLine}`}
>

  <!-- ══════════════════════════════════════════════
       PAGE HEADER
  ══════════════════════════════════════════════ -->
  <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] px-8 py-10 sm:px-12 sm:py-12" data-reveal>
    <div class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full bg-sky-400/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-indigo-400/8 blur-3xl"></div>

    <div class="relative max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.25em] text-sky-400/70">Get in touch</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
        Let's talk.
      </h1>
      <p class="mt-4 text-slate-400 leading-relaxed">
        Open to Data Analyst roles, BI projects, and analytics collaboration.
        I respond fastest to messages that include the role or project context.
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/25 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300 font-medium">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Open to roles
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-400">
          BI · Predictive Analytics · Decision Support
        </span>
        <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-400">
          {profile.location}
        </span>
      </div>
    </div>
  </div>


  <!-- ══════════════════════════════════════════════
       MAIN GRID
  ══════════════════════════════════════════════ -->
  <div class="mt-8 grid gap-6 lg:grid-cols-3 lg:items-start">

    <!-- LEFT: Primary contact -->
    <section class="lg:col-span-2 space-y-5" data-reveal>

      <!-- Email card -->
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-sky-400/20 bg-sky-400/8 text-sky-300">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h2 class="font-semibold text-slate-100">Email — fastest response</h2>
            <p class="mt-1 text-sm text-slate-400 leading-relaxed">
              Best for role inquiries, project discussions, and collaboration.
              Include the role title and what you'd like me to focus on.
            </p>
          </div>
        </div>

        <!-- Email display + copy -->
        <div class="mt-5 flex flex-col sm:flex-row sm:items-center gap-3 rounded-xl border border-white/10 bg-black/20 px-5 py-4">
          <a
            href={`mailto:${profile.email}`}
            class="flex-1 font-mono text-sm text-sky-400 hover:underline min-w-0 truncate"
          >
            {profile.email}
          </a>
          <div class="flex items-center gap-2 shrink-0">
            <span id="copy-status" class="text-xs text-emerald-400 opacity-0 transition-opacity duration-300"></span>
            <button
              id="copy-email"
              type="button"
              data-email={profile.email}
              class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-slate-200 hover:border-sky-400/30 hover:text-sky-200 transition-colors"
            >
              <svg id="copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              Copy
            </button>
            <a
              href={`mailto:${profile.email}`}
              class="inline-flex items-center gap-1.5 rounded-lg bg-sky-400 px-3 py-1.5 text-xs font-semibold text-slate-950 hover:opacity-90 transition-opacity"
            >
              Send email ↗
            </a>
          </div>
        </div>

        <p class="mt-3 text-xs text-slate-600">Typical response time: 24–48 hours.</p>
      </div>

      <!-- Other channels -->
      <div class="grid gap-4 sm:grid-cols-{channels.length > 2 ? '3' : '2'}">
        {channels.map(({ label, desc, href, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition duration-200 hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-0.5"
          >
            <div class="flex items-center justify-between gap-2">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-slate-400 transition duration-200 group-hover:border-sky-400/25 group-hover:text-sky-300">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
              </div>
              <span class="text-sky-400 opacity-0 transition duration-200 group-hover:opacity-100 group-hover:translate-x-0.5">↗</span>
            </div>
            <div class="mt-3 font-semibold text-sm text-slate-100">{label}</div>
            <div class="mt-1 text-xs text-slate-500 leading-relaxed">{desc}</div>
          </a>
        ))}
      </div>
    </section>


    <!-- RIGHT: Sidebar -->
    <aside class="space-y-5" data-reveal>

      <!-- Quick info -->
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500">Quick Info</h2>
        <div class="mt-4 space-y-3">
          {[
            { label: "Name", value: profile.name },
            { label: "Role", value: profile.roleLine },
            { label: "Location", value: profile.location },
            { label: "Status", value: "Open to opportunities", highlight: true },
          ].map(({ label, value, highlight }) => (
            <div class="flex flex-col gap-0.5">
              <span class="text-[10px] uppercase tracking-widest text-slate-600">{label}</span>
              <span class={`text-sm ${highlight ? "text-emerald-300 font-medium" : "text-slate-300"}`}>{value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Resume -->
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500">Resume</h2>
        <p class="mt-3 text-xs text-slate-500 leading-relaxed">
          View the interactive version or grab the PDF for applications.
        </p>
        <div class="mt-4 flex flex-col gap-2">
          <a
            href="/resume"
            class="flex items-center justify-center gap-2 rounded-xl bg-sky-400 px-4 py-2.5 text-sm font-semibold text-slate-950 hover:opacity-90 transition-opacity"
          >
            View Resume
          </a>
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 rounded-xl border border-white/10 px-4 py-2.5 text-sm text-slate-200 hover:bg-white/5 transition-colors"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            Download PDF
          </a>
        </div>
      </div>

      <!-- What to include tip -->
      <div class="rounded-2xl border border-amber-400/15 bg-amber-400/5 p-6">
        <div class="flex items-center gap-2">
          <span class="text-base">💡</span>
          <h2 class="text-sm font-semibold text-amber-300">Tips for faster replies</h2>
        </div>
        <ul class="mt-3 space-y-2 text-xs text-slate-400 leading-relaxed">
          <li class="flex gap-2"><span class="text-amber-400 shrink-0">→</span> Include the role title or project type</li>
          <li class="flex gap-2"><span class="text-amber-400 shrink-0">→</span> Mention if you need BI, analysis, or ML work</li>
          <li class="flex gap-2"><span class="text-amber-400 shrink-0">→</span> Timeline or start date if relevant</li>
        </ul>
      </div>
    </aside>
  </div>


  <!-- ══════════════════════════════════════════════
       COPY EMAIL SCRIPT
  ══════════════════════════════════════════════ -->
  <script>
    const btn = document.getElementById("copy-email") as HTMLButtonElement | null;
    const status = document.getElementById("copy-status") as HTMLElement | null;
    const icon = document.getElementById("copy-icon") as SVGElement | null;

    btn?.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email") ?? "";
      try {
        await navigator.clipboard.writeText(email);

        // Show success state
        if (status) {
          status.textContent = "Copied!";
          status.style.opacity = "1";
        }
        if (icon) {
          // Swap to checkmark
          icon.innerHTML = `<polyline points="20 6 9 17 4 12"/>`;
        }
        if (btn) btn.classList.add("border-emerald-400/30", "text-emerald-300");

        setTimeout(() => {
          if (status) { status.textContent = ""; status.style.opacity = "0"; }
          if (icon) icon.innerHTML = `<rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>`;
          if (btn) btn.classList.remove("border-emerald-400/30", "text-emerald-300");
        }, 2000);

      } catch {
        if (status) {
          status.textContent = "Copy manually";
          status.style.opacity = "1";
          setTimeout(() => { status.style.opacity = "0"; }, 2000);
        }
      }
    });
  </script>

</Layout>