---
import "../styles/global.css";
import { profile } from "../data/profile";

const {
  title = "Mohammad Abu Huzaifa | Data Analyst",
  description = "Data Analyst portfolio: dashboards, analytics, and data-driven systems.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={`${Astro.site?.href ?? "https://huzaifa1610.github.io/"}images/og.png`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.site?.href ?? "https://huzaifa1610.github.io/"}images/og.png`} />


    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>

  <body class="min-h-full bg-slate-950 text-slate-100 antialiased selection:bg-sky-400/30 selection:text-white">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur supports-[backdrop-filter]:bg-slate-950/70">
      <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
        <a href="/" class="font-semibold tracking-tight">
          {profile.name}
          <span class="text-sky-400">.</span>
        </a>


        <nav class="flex flex-wrap items-center gap-3 sm:gap-4 text-sm text-slate-300">
          <a class="hover:text-white" href="/">Home</a>
          <a class="hover:text-white" href="/projects">Projects</a>
          <a class="hover:text-white" href="/about">About</a>
          <a class="hover:text-white" href="/skills">Skills</a>
          <a class="hover:text-white" href="/resume">Resume</a>
          <a class="hover:text-white" href="/contact">Contact</a>
        </nav>
        <a
          class="rounded-lg bg-sky-400 px-3 py-1.5 text-sm font-semibold text-slate-950 hover:opacity-90"
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          Download CV
        </a>

      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-12 sm:py-14">
      <slot />
    </main>

    <footer class="border-t border-white/10">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-slate-400 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} Mohammad Abu Huzaifa</p>
        <div class="flex gap-4">
          <a class="hover:text-white" href={`mailto:${profile.email}`}>Email</a>
          <a class="hover:text-white" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="hover:text-white" href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>

      </div>
    </footer>
    <dialog
      id="lightbox"
      class="backdrop:bg-black/80 rounded-2xl border border-white/10 bg-slate-950 text-slate-100 w-[min(1100px,94vw)]"
    >
      <div class="p-4 sm:p-5">
        <div class="flex items-center justify-between gap-4">
          <div class="text-sm text-slate-300">
            <span class="text-slate-400">Screenshot</span>
            <span id="lb-count" class="ml-2 text-slate-300"></span>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="lb-prev"
              type="button"
              class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-200 hover:bg-white/5"
            >
              Prev
            </button>
            <button
              id="lb-next"
              type="button"
              class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-200 hover:bg-white/5"
            >
              Next
            </button>
            <button
              id="lb-close"
              type="button"
              class="rounded-lg border border-white/10 px-3 py-1.5 text-sm text-slate-200 hover:bg-white/5"
            >
            Close
            </button>
          </div>
        </div>

        <figure class="mt-4">
          <img
            id="lb-img"
            class="w-full rounded-xl border border-white/10 bg-black/30 object-contain"
            style="max-height: 74vh;"
            alt="Expanded screenshot"
          />
          <figcaption id="lb-caption" class="mt-3 text-sm text-slate-300"></figcaption>
        </figure>
      </div>
    </dialog>

    <script>
      // Lightbox: click any image with data-lightbox="true" to open
      const dlg = document.getElementById("lightbox");
      const imgEl = document.getElementById("lb-img");
      const capEl = document.getElementById("lb-caption");
      const countEl = document.getElementById("lb-count");

      const btnPrev = document.getElementById("lb-prev");
      const btnNext = document.getElementById("lb-next");
      const btnClose = document.getElementById("lb-close");

      let images = [];
      let index = 0;

      function setLightbox(i) {
        index = (i + images.length) % images.length;
        const item = images[index];

        imgEl.src = item.src;
        imgEl.alt = item.alt || "Screenshot";
        capEl.textContent = item.caption || "";
        countEl.textContent = `${index + 1} / ${images.length}`;
      }

      function openLightbox(i) {
        if (!dlg || !imgEl) return;
        setLightbox(i);
        dlg.showModal();
      }

      function closeLightbox() {
        if (!dlg) return;
        dlg.close();
      }

      function next() {
        if (!images.length) return;
        setLightbox(index + 1);
      }

      function prev() {
        if (!images.length) return;
        setLightbox(index - 1);
      }

      // Collect images on the current page
      function refreshImages() {
        images = Array.from(document.querySelectorAll('img[data-lightbox="true"]')).map((el) => ({
          src: el.getAttribute("src"),
          alt: el.getAttribute("alt"),
          caption: el.getAttribute("data-caption") || "",
        }));
      }

      // Attach click handlers
      function bind() {
        refreshImages();

        document.querySelectorAll('img[data-lightbox="true"]').forEach((el) => {
          el.style.cursor = "zoom-in";
          el.addEventListener("click", () => {
            refreshImages();
            const currentSrc = el.getAttribute("src");
            const i = Math.max(0, images.findIndex((x) => x.src === currentSrc));
            openLightbox(i);
          });
        });
      }

      // Run once on page load
      bind();

      btnNext?.addEventListener("click", next);
      btnPrev?.addEventListener("click", prev);
      btnClose?.addEventListener("click", closeLightbox);

      // Close when clicking outside the dialog box
      dlg?.addEventListener("click", (e) => {
        const rect = dlg.getBoundingClientRect();
        const inDialog =
          rect.top <= e.clientY && e.clientY <= rect.bottom && rect.left <= e.clientX && e.clientX <= rect.right;
        if (!inDialog) closeLightbox();
      });

      // Keyboard controls
      document.addEventListener("keydown", (e) => {
        if (!dlg?.open) return;
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowRight") next();
        if (e.key === "ArrowLeft") prev();
      });
    </script>
    
    <script>
      // Scroll reveal (uses IntersectionObserver, respects prefers-reduced-motion via CSS)
      const items = Array.from(document.querySelectorAll("[data-reveal]"));

      // If browser doesn't support IntersectionObserver, just show everything
      if (!("IntersectionObserver" in window)) {
        items.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target); // reveal once
              }
            }
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -10% 0px",
          }
        );

        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
